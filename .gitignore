# OpenWPS runtime data
openwps_server/data/conversations/
openwps_server/data/plans/
openwps_server/data/tasks/
openwps_server/data/agent_runs/
openwps_server/data/agents/
# OpenWPS workspace 自动版本快照（每次 AI 工具写入会生成 .docx 快照，本地累积太快）
openwps_server/data/workspaces/**/.openwps/versions/
openwps_server/data/workspaces/**/.openwps/index/
# OpenWPS 用户实际工作区文件（运行时生成，不该入库）
openwps_server/data/workspaces/**/files/*.docx
openwps_server/data/workspaces/**/files/*.md
!openwps_server/data/workspaces/**/files/.openwps/

# Backup files
*.bak

# Local scripts
/scripts/

# Root level package files only
/package-lock.json
/package.json

# Claude Code skills
.claude/
