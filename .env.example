APP_NAME=AI Writer Backend
APP_VERSION=0.0.1
DEBUG=False
HOST=0.0.0.0
PORT=28000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
OUTBOUND_PROXY_MODE=env
NO_PROXY_EXTRA=
UPLOAD_DIR=/app/backend/uploads
PARSE_OUTPUT_DIR=/app/backend/parsed_output
MAX_UPLOAD_SIZE=104857600
DATABASE_URL=sqlite+aiosqlite:////app/backend/data/ai_writer.db

# 云端向量数据库（Milvus / Zilliz Cloud / 托管 Milvus）
MILVUS_HOST=
MILVUS_PORT=
MILVUS_URI=https://your-cloud-milvus-endpoint
MILVUS_USER=
MILVUS_PASSWORD=

# MinerU 在线 API
MINERU_API_TOKEN=your_mineru_api_token
MINERU_BACKEND=api
MINERU_OUTPUT_DIR=/app/backend/parsed_output
MINERU_LANG=ch

# 云端模型 API
MODEL_PROVIDER=deepseek
CHAT_MODEL_PROVIDER=deepseek
EMBEDDING_MODEL_PROVIDER=openai
SKIP_EMBEDDING_WARMUP=true

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_CHAT_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_TYPE=disabled
DEEPSEEK_EMBEDDING_MODEL=

OPENAI_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_EMBEDDING_MODEL=BAAI/bge-m3
OPENAI_EMBEDDING_DIMENSIONS=1024

EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
