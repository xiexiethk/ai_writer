# FastAPI 配置
APP_NAME=AI Writer Backend
APP_VERSION=0.0.1
DEBUG=True
HOST=0.0.0.0
PORT=28000

# CORS 配置
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 文件存储配置
UPLOAD_DIR=./uploads
PARSE_OUTPUT_DIR=./parsed_data
MAX_UPLOAD_SIZE=104857600

# 出站网络配置
# direct: 启动时清理 HTTP(S)/ALL/GRPC 代理变量，避免 Clash 等系统代理接管模型请求
# env: 保持跟随当前 shell / 系统代理
OUTBOUND_PROXY_MODE=env
# 额外直连域名，逗号分隔
NO_PROXY_EXTRA=

# MinerU 配置
MINERU_BACKEND=pipeline
MINERU_OUTPUT_DIR=./parsed_output
MINERU_LANG=ch

# 数据库配置（可选，目前使用 JSON 存储）
# DATABASE_URL=sqlite:///./ai_writer.db

# 在线向量数据库（Milvus / Zilliz Cloud）
MILVUS_URI=https://your-milvus-endpoint
MILVUS_USER=your_user
MILVUS_PASSWORD=your_password

# 模型服务配置（全部在线）
MODEL_PROVIDER=deepseek
CHAT_MODEL_PROVIDER=deepseek
EMBEDDING_MODEL_PROVIDER=openai

# DeepSeek（聊天 API）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_CHAT_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_TYPE=disabled

# Embedding（OpenAI 兼容在线接口，可接 SiliconFlow / OpenAI）
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

OPENAI_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_EMBEDDING_MODEL=BAAI/bge-m3
OPENAI_EMBEDDING_DIMENSIONS=1024
